<html>
<head>
<meta charset="UTF-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="preconnect" href="https://fonts.gstatic.com">
<link href="https://fonts.googleapis.com/css2?family=Libre+Franklin:ital,wght@0,500;0,700;1,400&display=swap" rel="stylesheet">
<title> OTP Verification </title>

<style type="text/css">
body{
  font-family: 'Libre Franklin', sans-serif;
}
</style>

</head>
<body style="background-color: #F7F7F7; margin: 0; width: 100%; font-family: 'Libre Franklin', sans-serif; padding: 50px 0;">
  <center  style="width: 600px; margin: auto;">
    <table style="width: 100%;" class="mail-header">
        <tbody>
            <tr>
                <td align="center">
                    <img src="https://credexon.com/images/logo.svg" alt="Logo" style="margin: auto; height: auto; display: block;">
                </td>
            </tr>
            <tr>
                <td height="40"></td>
            </tr>
            <tr>
                <td align="center" style="color: #58585A; font-size: 30px; font-weight: normal;">
                    Dear  <span style="color: #000; font-weight: bold;"> User,</span>
                </td>
            </tr>
            <tr>
                <td height="10"></td>
            </tr>
             
            <tr>
				<td align="center"  style="color: #58585A; font-size: 24px; font-weight: normal;"> {{MailMessage}}</td>
            </tr>
        </tbody>
    </table>
 

    <table cellpadding="0" cellspacing="0" width="100%" class="mail-footer" align="center">
        <tbody>
            
            <tr align="center">
                <td style="color:#58585A; font-weight: bold; font-size: 12px;">  © 2023 Credexon All Rights Reserved </td>
            </tr>
            <tr>
                <td height="10"></td>
            </tr>
        </tbody>
    </table>
  </center>
</body>
</html>